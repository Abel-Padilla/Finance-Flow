{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src tamagui.config.ts --max-warnings 0",
    "export": "expo export --platform ios --platform android",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "node --env-file=../api/.env --import tsx --test test/api.integration.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@tamagui/config": "1.144.4",
    "@tamagui/lucide-icons": "1.144.4",
    "expo": "57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.65.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tamagui": "1.144.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.7",
    "babel-preset-expo": "~57.0.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
